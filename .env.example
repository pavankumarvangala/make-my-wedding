# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=

# Authentication and token HMAC operations (server-side only)
TOKEN_HMAC_SECRET=

# Cloudflare R2 (server-side only; use environment-specific bucket credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# Google Places (server-side only)
GOOGLE_PLACES_API_KEY=

# Protected Vercel Cron endpoint
CRON_SECRET=
